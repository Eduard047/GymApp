  "strings" : {
    "%@ / %@" : {
      "comment" : "A label showing the current progress towards a mission's target. The first argument is the current progress. The second argument is the target value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
