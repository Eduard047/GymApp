    "Only this set will be deleted. Undo is available briefly while you stay on this screen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only this set will be deleted. Undo is available briefly while you stay on this screen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде видалено лише цей підхід. Скасування доступне протягом короткого часу, поки ти залишаєшся на цьому екрані."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалён только этот подход. Отмена доступна в течение короткого времени, пока ты остаёшься на этом экране."
          }
        }
      }
    },
    "This is the final set for the exercise, so the exercise will also be deleted from the workout. Undo is available briefly while you stay on this screen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the final set for the exercise, so the exercise will also be deleted from the workout. Undo is available briefly while you stay on this screen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це останній підхід вправи, тому вправу також буде видалено з тренування. Скасування доступне протягом короткого часу, поки ти залишаєшся на цьому екрані."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
