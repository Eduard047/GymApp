    },
    "Weighted Side Bend" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боковые наклоны с отягощением"
          }
        }
      }
    },
    "Ends this session without deleting your account or cloud data. Your selected Garmin watch remains paired until you explicitly revoke it." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Завершує цей сеанс без видалення облікового запису або хмарних даних. Вибраний годинник Garmin залишиться сполученим, доки ти явно не відкличеш його." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Завершает этот сеанс без удаления учётной записи или облачных данных. Выбранные часы Garmin останутся подключёнными, пока ты явно не отзовёшь их." } }
      }
    },
    "Garmin watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Годинник Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Часы Garmin" } }
      }
    },
    "Garmin" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Garmin" } }
      }
    },
    "Paired watches" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Сполучені годинники" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключённые часы" } }
      }
    },
    "Choose exactly which active watch receives iOS workout plans. The selected device is stored securely for this Supabase account." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Вибери, який саме активний годинник отримуватиме плани тренувань з iOS. Вибраний пристрій безпечно зберігається для цього облікового запису Supabase." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выбери, какие именно активные часы будут получать планы тренировок с iOS. Выбранное устройство безопасно сохраняется для этой учётной записи Supabase." } }
      }
    },
    "Open Gym Workout Tracker in Garmin" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкрити Gym Workout Tracker у Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть Gym Workout Tracker в Garmin" } }
      }
    },
    "Opens this app in Connect IQ, or opens the App Store if Connect IQ is not installed" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкриває цей застосунок у Connect IQ або App Store, якщо Connect IQ не встановлено" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает это приложение в Connect IQ или App Store, если Connect IQ не установлен" } }
      }
    },
    "Loading Garmin watches…" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Завантаження годинників Garmin…" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка часов Garmin…" } }
      }
    },
    "No active Garmin watches found." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Активних годинників Garmin не знайдено." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Активные часы Garmin не найдены." } }
      }
    },
    "Refresh watches" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Оновити список годинників" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновить список часов" } }
      }
    },
    "Rotate token for selected watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Оновити токен вибраного годинника" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сменить токен выбранных часов" } }
      }
    },
    "Use token rotation to reconnect the same watch. It preserves the device ID already pinned by the Garmin app." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Щоб повторно підключити той самий годинник, онови токен. Це збереже ідентифікатор пристрою, уже закріплений застосунком Garmin." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чтобы повторно подключить те же часы, смени токен. Это сохранит идентификатор устройства, уже закреплённый приложением Garmin." } }
      }
    },
    "Revoke selected watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкликати вибраний годинник" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отозвать выбранные часы" } }
      }
    },
    "Watch name" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Назва годинника" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Название часов" } }
      }
    },
    "A label up to 80 characters for a new Garmin watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Назва нового годинника Garmin довжиною до 80 символів" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Название новых часов Garmin длиной до 80 символов" } }
      }
    },
    "Pairing…" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Підключення…" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключение…" } }
      }
    },
    "Pair a brand-new watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Підключити новий годинник" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключить новые часы" } }
      }
    },
    "Create a new device ID only for a watch that has never used GymApp cloud sync. For an existing watch, select it above or rotate its token." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Створюй новий ідентифікатор пристрою лише для годинника, який ще не використовував хмарну синхронізацію GymApp. Для наявного годинника вибери його вище або онови його токен." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создавай новый идентификатор устройства только для часов, которые ещё не использовали облачную синхронизацию GymApp. Для существующих часов выбери их выше или смени их токен." } }
      }
    },
    "Revoke selected Garmin watch?" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкликати вибраний годинник Garmin?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отозвать выбранные часы Garmin?" } }
      }
    },
    "Revoke" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкликати" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отозвать" } }
      }
    },
    "This invalidates the watch token and quarantines its pending plans. Reusing this watch with a new device ID requires resetting GymApp on the watch. Use token rotation instead when reconnecting the same watch." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Це зробить токен годинника недійсним і перемістить його плани в очікуванні до карантину. Щоб повторно використати цей годинник із новим ідентифікатором пристрою, потрібно скинути GymApp на годиннику. Для повторного підключення того самого годинника натомість онови токен." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это сделает токен часов недействительным и поместит ожидающие планы в карантин. Чтобы повторно использовать эти часы с новым идентификатором устройства, нужно сбросить GymApp на часах. Для повторного подключения тех же часов вместо этого смени токен." } }
      }
    },
    "Selected" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Вибрано" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выбрано" } }
      }
    },
    "Not selected" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вибрано" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не выбрано" } }
      }
    },
    "One-time secret" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Одноразовий секрет" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Одноразовый секрет" } }
      }
    },
    "Save the Garmin token now" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Збережи токен Garmin зараз" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохрани токен Garmin сейчас" } }
      }
    },
    "Paste this token only into GymApp settings in Garmin Connect IQ. It will not be stored or shown again." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Встав цей токен лише в налаштування GymApp у Garmin Connect IQ. Він не зберігатиметься й більше не показуватиметься." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вставь этот токен только в настройки GymApp в Garmin Connect IQ. Он не будет сохранён или показан снова." } }
      }
    },
    "One-time Garmin pairing token" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Одноразовий токен сполучення Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Одноразовый токен подключения Garmin" } }
      }
    },
    "Copied for 5 minutes" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скопійовано на 5 хвилин" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировано на 5 минут" } }
      }
    },
    "Copy token" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скопіювати токен" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать токен" } }
      }
    },
    "Copying is optional and requires confirmation. The clipboard item stays on this device and expires after five minutes, but another app opened during that time may be able to read it." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Копіювання необов’язкове й потребує підтвердження. Елемент буфера обміну залишається на цьому пристрої та видаляється через п’ять хвилин, але інший застосунок, відкритий протягом цього часу, може його прочитати." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Копирование необязательно и требует подтверждения. Элемент буфера обмена остаётся на этом устройстве и удаляется через пять минут, но другое приложение, открытое в это время, может его прочитать." } }
      }
    },
    "I saved the token" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Токен збережено" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Токен сохранён" } }
      }
    },
    "Revoking…" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкликання…" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отзыв…" } }
      }
    },
    "Cancel and revoke this new watch" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скасувати й відкликати цей новий годинник" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отменить и отозвать эти новые часы" } }
      }
    },
    "Close without saving" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Закрити без збереження" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрыть без сохранения" } }
      }
    },
    "Garmin pairing" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Сполучення з Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключение Garmin" } }
      }
    },
    "Copy this secret token?" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скопіювати цей секретний токен?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать этот секретный токен?" } }
      }
    },
    "Copy for 5 minutes" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скопіювати на 5 хвилин" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать на 5 минут" } }
      }
    },
    "Only continue if you will paste it directly into this watch’s Garmin Connect IQ settings. Do not send or save it elsewhere." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Продовжуй, лише якщо одразу вставиш його в налаштування Garmin Connect IQ цього годинника. Не надсилай і не зберігай його деінде." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Продолжай, только если сразу вставишь его в настройки Garmin Connect IQ на этих часах. Не отправляй и не сохраняй его в других местах." } }
      }
    },
    "Your session expired. Sign in again." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії сеансу минув. Увійдіть знову."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия сеанса истёк. Войдите снова."
          }
        }
      }
    },
    "Front" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Спереду" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Спереди" } }
      }
    },
    "Plan builder" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Конструктор плану" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Конструктор плана" } }
      }
    },
    "Planned exercises and sets" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Заплановані вправи та підходи" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запланированные упражнения и подходы" } }
      }
    },
    "Planned rows are targets. They do not start rest timers or count as completed until you save them." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Заплановані рядки — це цілі. Вони не запускають таймери відпочинку й не вважаються виконаними, доки ви їх не збережете." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запланированные строки — это цели. Они не запускают таймеры отдыха и не считаются выполненными, пока вы их не сохраните." } }
      }
    },
    "Garmin plan mode: after saving, every planned row is sent to the selected watch as a target. The watch logs what you actually complete." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Режим плану Garmin: після збереження кожен запланований рядок надсилається на вибраний годинник як ціль. Годинник записує те, що ви фактично виконаєте." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Режим плана Garmin: после сохранения каждая запланированная строка отправляется на выбранные часы как цель. Часы записывают то, что вы фактически выполните." } }
      }
    },
    "Completed mode: saving immediately adds every planned row to workout history and summaries." : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Режим виконаного тренування: збереження негайно додає кожен запланований рядок до історії та підсумків тренувань." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Режим выполненной тренировки: сохранение сразу добавляет каждую запланированную строку в историю и сводки тренировок." } }
      }
    },
    "Save as completed workout" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Зберегти як виконане тренування" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранить как выполненную тренировку" } }
      }
    },
    "Adds every planned row to history as completed and also queues the rows as Garmin targets" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Додає кожен запланований рядок до історії як виконаний і також ставить рядки в чергу як цілі Garmin" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавляет каждую запланированную строку в историю как выполненную и также ставит строки в очередь как цели Garmin" } }
      }
    },
    "Adds every planned row to history and summaries as completed" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Додає кожен запланований рядок до історії та підсумків як виконаний" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавляет каждую запланированную строку в историю и сводки как выполненную" } }
      }
    },
    "Back" : {
      "localizations" : {
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ззаду" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сзади" } }
      }
    }
  },
  "version" : "1.1"
}
