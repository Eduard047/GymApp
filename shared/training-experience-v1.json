{
  "version": 1,
  "clients": ["android", "ios", "pwa"],
  "profileDefaults": {
    "split": "upperLower",
    "workoutsPerWeek": 4,
    "goal": "aestheticFatLoss",
    "calorieMode": "deficit"
  },
  "activation": {
    "emptyHistoryOnly": true,
    "workoutsPerWeek": {
      "minimum": 2,
      "maximum": 6,
      "default": 4
    },
    "efforts": [
      "recovery",
      "standard",
      "hard"
    ],
    "defaultEffort": "standard",
    "splitByWorkoutsPerWeek": {
      "2": "fullBody",
      "3": "fullBody",
      "4": "upperLower",
      "5": "pushPullLegs",
      "6": "pushPullLegs"
    },
    "calorieModeByGoal": {
      "aestheticFatLoss": "deficit",
      "muscleGain": "surplus",
      "strength": "maintenance",
      "balanced": "maintenance"
    },
    "skipPersistsPerAccount": true
  },
  "weeklyRhythm": {
    "weekStartsOn": "monday",
    "countingUnit": "distinctLocalTrainingDay",
    "todayHistoryNavigation": {
      "range": "currentOrPastWeekOnly",
      "controls": ["previous", "current", "next", "swipe"],
      "selectedWeekIncludesSavedWorkoutLinks": true,
      "futureWeekDisabled": true,
      "accountBoundPresentationState": true
    },
    "decisions": [
      "train",
      "recovery",
      "rest"
    ],
    "restIsAdvisory": true,
    "targetMinimum": 2,
    "targetMaximum": 6,
    "primaryHabitMetric": "profileTargetWeeklyStreak",
    "streakAchievementWeeks": [2, 4, 8]
  },
  "smartPlan": {
    "maximumExercises": 8,
    "maximumWorkingSets": 24,
    "maximumSetsPerExercise": 4,
    "minimumExercises": 4,
    "minimumSetsPerExercise": 3,
    "frequencyBaseSets": {
      "2": 20,
      "3": 18,
      "4": 16,
      "5": 15,
      "6": 14
    },
    "goalSetAdjustment": {
      "aestheticFatLoss": -2,
      "muscleGain": 2,
      "strength": -1,
      "balanced": 0
    },
    "calorieSetAdjustment": {
      "deficit": -2,
      "maintenance": 0,
      "surplus": 2
    },
    "effortSetAdjustment": {
      "recovery": -3,
      "standard": 0,
      "hard": 1
    },
    "minimumWorkingSets": {
      "recovery": 12,
      "standard": 12,
      "hard": 13
    },
    "hardReservedSets": 1,
    "exerciseCountRounding": "floor"
  },
  "launchSeed": {
    "accountBound": true,
    "profileCatalogAndHistoryBound": true,
    "maximumAgeMilliseconds": 300000,
    "futureSkewMilliseconds": 60000,
    "oneTimeUse": true
  },
  "feedback": {
    "values": [
      "easy",
      "normal",
      "hard"
    ],
    "storage": "accountLocalSidecar",
    "maximumEntries": 128,
    "coachMaximumAgeDays": 7,
    "easyMaximumExtraSets": 1,
    "cloudAndBackupSessionShapeUnchanged": true
  }
}
