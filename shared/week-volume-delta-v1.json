{
  "version": 1,
  "rule": "Week starts Monday in the case zone. weekOffset 0: compare Monday..today of the current week with the same number of days (Monday..) of the previous week; weekOffset < 0: compare the whole selected week with the whole previous week. Sessions after 'now' are ignored. Volumes that are negative or not finite count as 0. percent = (current - previous) * 100 / previous rounded half away from zero, capped at 999; null when previous volume is 0. 'at' and 'now' are local date-times in the case zone.",
  "cases": [
    {
      "id": "same-days-increase",
      "description": "Wed: Mon..Wed this week vs Mon..Wed last week; last Thursday is outside the same days",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-02T08:00:00",
          "volume": 1000
        },
        {
          "at": "2026-11-04T09:00:00",
          "volume": 500
        },
        {
          "at": "2026-10-26T08:00:00",
          "volume": 1000
        },
        {
          "at": "2026-10-29T08:00:00",
          "volume": 2000
        }
      ],
      "expectedPercent": 50
    },
    {
      "id": "same-days-decrease",
      "description": "Minus sign case",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-03T08:00:00",
          "volume": 920
        },
        {
          "at": "2026-10-27T08:00:00",
          "volume": 1000
        }
      ],
      "expectedPercent": -8
    },
    {
      "id": "round-half-up",
      "description": "12.5 rounds away from zero to 13",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-03T08:00:00",
          "volume": 1125
        },
        {
          "at": "2026-10-27T08:00:00",
          "volume": 1000
        }
      ],
      "expectedPercent": 13
    },
    {
      "id": "round-half-down-negative",
      "description": "-12.5 rounds away from zero to -13",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-03T08:00:00",
          "volume": 875
        },
        {
          "at": "2026-10-27T08:00:00",
          "volume": 1000
        }
      ],
      "expectedPercent": -13
    },
    {
      "id": "round-below-half",
      "description": "0.4 rounds to 0",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-03T08:00:00",
          "volume": 1004
        },
        {
          "at": "2026-10-27T08:00:00",
          "volume": 1000
        }
      ],
      "expectedPercent": 0
    },
    {
      "id": "cap-999",
      "description": "1900 percent is capped at 999",
      "zone": "UTC",
      "now": "2026-11-04T12:00:00",
      "weekOffset": 0,
      "sessions": [
        {
          "at": "2026-11-03T08:00:00",
          "volume": 20000
        },
        {
          "at": "2026-10-27T08:00:00",
          "volume": 1000
        }
