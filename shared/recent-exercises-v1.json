{
  "version": 1,
  "description": "Exercise picker: the 'Recent' section shown above the list while the search field is empty (T169). Implemented by recentExerciseIds on Android; iPhone must produce identical results.",
  "scope": "Add-exercise picker of the plan editor and the saved-workout editor. The Progress 'choose exercise' picker has no Recent section. The section is also hidden while any picker filter chip (Frequent, Favorites, body part, muscle) is active; that part is UI-only and not covered by the cases. The recent exercises keep their normal position in the list below, and an exercise already in the plan keeps the picker's usual 'added' check and disabled state in the Recent row too.",
  "rules": [
    "1. Source = rows of completed workouts. Sessions go newest first by date; if several sessions share a date, the greater sessionId (later stored) is newer. Inside a session exercises go in ascending blockOrderIndex.",
    "2. Every logged set row counts, whatever its weight and reps. A block with no logged sets contributes no row (Android has no row for it; iPhone skips the empty block).",
    "3. Exercises are distinct by exerciseId, the first occurrence in that order wins (an exercise in two blocks of one session, or in several sessions, is listed once).",
    "4. Only exercises present in eligibleExerciseIds (the picker's own list: no longer existing, archived or hidden exercises are not in it) are listed. Skipped exercises do not use up a slot.",
    "5. At most 8 exercises (after skipping).",
    "6. Search text that is not blank (after trimming) hides the section: expected = []. An empty history or an empty picker list also gives [] (the section is not drawn)."
  ],
  "inputFields": {
    "query": "current search field text",
    "eligibleExerciseIds": "ids of the exercises the picker lists",
    "history": "rows of one logged set each: exerciseId, sessionId, date (any comparable number, e.g. epoch ms), blockOrderIndex (position of the exercise block in the workout). Several rows with the same keys are several sets of one block."
  },
  "outputField": "expected = exercise ids of the Recent section, top to bottom; [] means the section is not shown",
