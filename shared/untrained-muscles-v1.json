{
  "version": 1,
  "description": "Heatmap hint 'Not trained for 10+ days: ...' (T181). Implemented by untrainedMuscleIds on Android and GymUntrainedMuscles.untrainedMuscleIDs on iPhone; both must produce identical results.",
  "rules": [
    "1. Candidate groups are the major muscles in 'majorMuscles' (the muscles the existing Balance recommendation watches), in heatmap display order. No new taxonomy; the heatmap has only these fine muscles, no roll-up.",
    "2. Eligibility: the user has at least 3 workouts in total AND at least one workout whose local calendar date is at most 30 days before today's local date. Otherwise the result is empty (new or inactive users).",
    "3. A group's last trained day is the latest local calendar date of any set with reps > 0 whose contribution weight for that group is > 0. Sets for muscles outside majorMuscles are ignored.",
    "4. A group is untrained when it was never trained, or when the number of local calendar days between its last trained day and today is 10 or more. A future-dated set counts as recent.",
    "5. Order: never-trained groups first, then the longest untrained first; ties keep the heatmap display order. At most 3 groups are returned. An empty result hides the line.",
    "6. Independent of the selected heatmap period. 'Today' and every day are taken in the device local time zone (timeZone in the app).",
    "7. Display (identical on both platforms): en 'Not trained for 10+ days: %s' / uk 'Не тренувалися понад 10 днів: %s' / ru 'Не тренировались больше 10 дней: %s', %s = the localized group names joined with ', '. A flat secondary-text line under the muscle map, no card."
  ],
  "constants": {
    "minWorkouts": 3,
    "recentWorkoutDays": 30,
    "untrainedDays": 10,
    "maxGroups": 3
  },
  "majorMuscles": [
    "chest",
    "lats",
    "upperBack",
    "glutes",
    "quads",
    "hamstrings"
  ],
  "inputFields": {
    "timeZone": "IANA zone id used for local calendar days",
    "now": "current instant (epoch ms)",
    "workouts": "dates (epoch ms) of all completed workouts",
    "sets": "logged sets: date (epoch ms), reps, muscles = muscle id -> contribution weight"
  },
  "outputField": "expected: muscle ids in display order of the hint",
