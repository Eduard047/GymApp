    { "id": "deadlift-english", "query": "deadlift", "expectedWorkoutIds": ["w4", "w6"] },
    { "id": "tyaga-ukrainian", "query": "тяга", "expectedWorkoutIds": ["w1", "w4", "w5", "w6"] },
    { "id": "partial-word", "query": "dead", "expectedWorkoutIds": ["w4", "w6"] },
