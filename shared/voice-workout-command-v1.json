{
  "version": 1,
  "mode": "inWorkoutCommand",
  "clients": ["android", "ios", "pwa"],
  "extends": {
    "contract": "voice-workout-v1.json",
    "reusedTables": ["repWords", "weightWords", "connectorWords", "numberWords"],
    "note": "Command mode is a separate entry point from plan dictation (different trigger, different result shape, no exercise resolution). It is defined here as a sibling contract rather than folded into voice-workout-v1.json because that contract's case/result schema (blocks/exercises/sets) is specific to whole-plan dictation; a single in-workout utterance produces one typed intent, not a block list. To avoid vocabulary drift, command parsing reuses voice-workout-v1.json's repWords/weightWords/connectorWords/numberWords tables verbatim (same objects in pwa/voice-workout.js) instead of redefining them here. Decimal-comma and spoken-number-word parsing reuse the same tokenizer as plan dictation unchanged; this step adds no new number-word vocabulary (e.g. no half-word fractions like 'с половиной' — not supported by the base contract either)."
  },
  "privacy": {
    "recognition": "onDeviceOnly",
    "storesAudio": false,
    "storesTranscript": false,
    "unavailableFallback": "manualTextEntry",
    "autoStopSeconds": 60
  },
  "units": {
    "weight": "kg",
    "note": "kg only. The base voice-workout-v1.json weightWords table has no lb/lbs/pound entries, so pound support does not exist to extend; adding it is out of scope for this step."
  },
  "limits": {
    "maxTranscriptBytes": 8192,
    "minWeightKg": 0,
    "maxWeightKg": 1000,
    "weightStepKg": 0.25,
    "minReps": 1,
    "maxReps": 200
  },
  "fillerWords": [
    "ну", "эм", "окей", "ага",
    "емм", "гаразд",
    "um", "uh", "okay", "ok"
  ],
  "intents": {
    "logSet": {
      "result": "{ intent: 'logSet', weightKg?: number, reps?: number }",
      "bodyweightPhrases": [
        "с собственным весом", "собственным весом", "своим весом",
        "власною вагою", "власним вагою", "з власною вагою",
        "bodyweight", "body weight", "own bodyweight"
      ],
      "separatorWords": "reuses voice-workout-v1.json rules.connectorWords for the 'weight на/x/×/by reps' two-number pattern (на, x, х, ×, by, for, ...)",
      "notes": [
        "'80 на 8', '80 кг на 8', 'восемьдесят на восемь', '80 x 8', '80 by 8', '80 kg for 8 reps', '80 на 8 повторов' -> weightKg and reps both set.",
        "'8 повторов' (reps word tags the only number) -> reps set, weightKg omitted; client fills weight from the current set.",
        "'80 кило' (weight word tags the only number) -> weightKg set, reps omitted; client fills reps from the current set.",
        "A bodyweight phrase followed by one number -> weightKg: 0, reps: <number>.",
        "A single untagged number with no unit word and no pairing number ('восемьдесят') is ambiguous (could be weight or reps) -> unknown, never guessed.",
        "Two untagged numbers with no separator/connector token between them -> unknown (ambiguous), not silently ordered as weight-then-reps."
      ]
    },
    "repeatPrevious": {
      "result": "{ intent: 'repeatPrevious' }",
      "phrases": [
        "повтори", "ещё раз так же", "то же самое", "повтор",
        "ще раз",
        "repeat", "same again"
      ]
    },
    "skipRest": {
      "result": "{ intent: 'skipRest' }",
      "phrases": [
        "дальше", "пропусти отдых", "готов", "поехали",
        "далі", "пропусти відпочинок", "готовий",
        "next", "skip rest", "ready"
      ]
    },
    "unknown": {
      "result": "{ intent: 'unknown', transcript: string, code?: string }",
      "diagnosticCodes": [
        "empty", "transcriptTooLong",
        "ambiguousNumbers", "weightOutOfRange", "repsOutOfRange", "invalidWeightStep",
        "noMatch"
      ],
      "notes": "Anything that is not a recognized logSet/repeatPrevious/skipRest utterance, including out-of-range values and ambiguous numbers, resolves to unknown with the original transcript so the client can show it verbatim. unknown records nothing."
    }
  },
  "clientContract": {
    "afterLogSetOrRepeatPrevious": "Record the CURRENT set through the same code path as the visible 'Log set' action (PWA data-action=\"detail-add-set\"; equivalent native action on Android/iOS), respecting any live-room freeze/commit lock exactly as the button does. Then start rest and show an undo affordance for the just-logged set.",
    "afterSkipRest": "Advance past the active rest period the same way the visible skip/ready control does.",
    "afterUnknown": "Show the transcript text to the user and record nothing."
  },
  "caseInsensitivity": "Matching is case, ё/е, and punctuation insensitive, and ignores fillerWords, using the same normalization as voice-workout-v1.json (normalizeWord/tokenize).",
  "cases": [
    { "id": "ru-logset-connector", "language": "ru", "transcript": "80 на 8",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-logset-kg-unit", "language": "ru", "transcript": "80 кг на 8",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-logset-number-words", "language": "ru", "transcript": "восемьдесят на восемь",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-logset-rep-word-confirms", "language": "ru", "transcript": "80 на 8 повторов",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-logset-no-connector-both-tagged", "language": "ru", "transcript": "80 кг 8 повторов",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-logset-reps-only", "language": "ru", "transcript": "8 повторов",
      "expected": { "intent": "logSet", "reps": 8 } },
    { "id": "ru-logset-weight-only", "language": "ru", "transcript": "80 кило",
      "expected": { "intent": "logSet", "weightKg": 80 } },
    { "id": "ru-logset-bodyweight", "language": "ru", "transcript": "с собственным весом 12",
      "expected": { "intent": "logSet", "weightKg": 0, "reps": 12 } },
    { "id": "ru-logset-decimal-comma", "language": "ru", "transcript": "82,5 на 6",
      "expected": { "intent": "logSet", "weightKg": 82.5, "reps": 6 } },
    { "id": "ru-repeat-word", "language": "ru", "transcript": "повтори",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "ru-repeat-phrase", "language": "ru", "transcript": "ещё раз так же",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "ru-repeat-same", "language": "ru", "transcript": "то же самое",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "ru-repeat-short", "language": "ru", "transcript": "повтор",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "ru-skip-next", "language": "ru", "transcript": "дальше",
      "expected": { "intent": "skipRest" } },
    { "id": "ru-skip-phrase", "language": "ru", "transcript": "пропусти отдых",
      "expected": { "intent": "skipRest" } },
    { "id": "ru-skip-ready", "language": "ru", "transcript": "готов",
      "expected": { "intent": "skipRest" } },
    { "id": "ru-skip-go", "language": "ru", "transcript": "поехали",
      "expected": { "intent": "skipRest" } },
    { "id": "ru-out-of-range-weight", "language": "ru", "transcript": "1500 на 8",
      "expected": { "intent": "unknown", "code": "weightOutOfRange" } },
    { "id": "ru-out-of-range-reps", "language": "ru", "transcript": "80 на 500",
      "expected": { "intent": "unknown", "code": "repsOutOfRange" } },
    { "id": "ru-invalid-weight-step", "language": "ru", "transcript": "80,3 на 8",
      "expected": { "intent": "unknown", "code": "invalidWeightStep" } },
    { "id": "ru-logset-micro-plate-step", "language": "ru", "transcript": "81,25 на 5",
      "expected": { "intent": "logSet", "weightKg": 81.25, "reps": 5 } },
    { "id": "ru-ambiguous-single-number", "language": "ru", "transcript": "восемьдесят",
      "expected": { "intent": "unknown", "code": "ambiguousNumbers" } },
    { "id": "ru-ambiguous-two-numbers-no-connector", "language": "ru", "transcript": "80 8",
      "expected": { "intent": "unknown", "code": "ambiguousNumbers" } },
    { "id": "ru-non-command-speech", "language": "ru", "transcript": "как дела",
      "expected": { "intent": "unknown", "code": "noMatch" } },
    { "id": "ru-filler-words-ignored", "language": "ru", "transcript": "ну эм восемьдесят на восемь",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "ru-case-and-punctuation-insensitive", "language": "ru", "transcript": "ВОСЕМЬДЕСЯТ, НА восемь!",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "uk-logset-connector-number-words", "language": "uk", "transcript": "вісімдесят на вісім",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "uk-logset-kg-unit-rep-word", "language": "uk", "transcript": "80 кг на 8 повторів",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "uk-logset-reps-only", "language": "uk", "transcript": "8 повторів",
      "expected": { "intent": "logSet", "reps": 8 } },
    { "id": "uk-logset-weight-only", "language": "uk", "transcript": "80 кіло",
      "expected": { "intent": "logSet", "weightKg": 80 } },
    { "id": "uk-logset-bodyweight", "language": "uk", "transcript": "власною вагою 12",
      "expected": { "intent": "logSet", "weightKg": 0, "reps": 12 } },
    { "id": "uk-repeat-phrase", "language": "uk", "transcript": "ще раз",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "uk-repeat-word", "language": "uk", "transcript": "повтори",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "uk-skip-next", "language": "uk", "transcript": "далі",
      "expected": { "intent": "skipRest" } },
    { "id": "uk-skip-phrase", "language": "uk", "transcript": "пропусти відпочинок",
      "expected": { "intent": "skipRest" } },
    { "id": "uk-skip-ready", "language": "uk", "transcript": "готовий",
      "expected": { "intent": "skipRest" } },
    { "id": "uk-out-of-range-weight", "language": "uk", "transcript": "2000 на 8",
      "expected": { "intent": "unknown", "code": "weightOutOfRange" } },
    { "id": "uk-ambiguous-single-number", "language": "uk", "transcript": "вісімдесят",
      "expected": { "intent": "unknown", "code": "ambiguousNumbers" } },
    { "id": "en-logset-x-separator", "language": "en", "transcript": "80 x 8",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "en-logset-by-separator", "language": "en", "transcript": "80 by 8",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "en-logset-kg-for-reps", "language": "en", "transcript": "80 kg for 8 reps",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "en-logset-reps-only", "language": "en", "transcript": "8 reps",
      "expected": { "intent": "logSet", "reps": 8 } },
    { "id": "en-logset-weight-only", "language": "en", "transcript": "80 kg",
      "expected": { "intent": "logSet", "weightKg": 80 } },
    { "id": "en-logset-bodyweight", "language": "en", "transcript": "bodyweight 12",
      "expected": { "intent": "logSet", "weightKg": 0, "reps": 12 } },
    { "id": "en-logset-number-words", "language": "en", "transcript": "eighty by eight",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "en-repeat-word", "language": "en", "transcript": "repeat",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "en-repeat-same-again", "language": "en", "transcript": "same again",
      "expected": { "intent": "repeatPrevious" } },
    { "id": "en-skip-next", "language": "en", "transcript": "next",
      "expected": { "intent": "skipRest" } },
    { "id": "en-skip-rest-phrase", "language": "en", "transcript": "skip rest",
      "expected": { "intent": "skipRest" } },
    { "id": "en-skip-ready", "language": "en", "transcript": "ready",
      "expected": { "intent": "skipRest" } },
    { "id": "en-out-of-range-weight", "language": "en", "transcript": "1500 x 8",
      "expected": { "intent": "unknown", "code": "weightOutOfRange" } },
    { "id": "en-out-of-range-reps", "language": "en", "transcript": "80 x 500",
      "expected": { "intent": "unknown", "code": "repsOutOfRange" } },
    { "id": "en-invalid-weight-step", "language": "en", "transcript": "80.3 x 8",
      "expected": { "intent": "unknown", "code": "invalidWeightStep" } },
    { "id": "en-ambiguous-single-number", "language": "en", "transcript": "eighty",
      "expected": { "intent": "unknown", "code": "ambiguousNumbers" } },
    { "id": "en-non-command-speech", "language": "en", "transcript": "how's it going",
      "expected": { "intent": "unknown", "code": "noMatch" } },
    { "id": "en-filler-words-ignored", "language": "en", "transcript": "um okay 80 x 8",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "en-case-and-punctuation-insensitive", "language": "en", "transcript": "EIGHTY, BY eight!",
      "expected": { "intent": "logSet", "weightKg": 80, "reps": 8 } },
    { "id": "empty-transcript", "language": "en", "transcript": "   ",
      "expected": { "intent": "unknown", "code": "empty" } },
    { "id": "too-long-transcript", "language": "en", "transcriptRepeat": { "text": "x", "count": 8193 },
      "expected": { "intent": "unknown", "code": "transcriptTooLong" } }
  ]
}
