{
  "version": 1,
  "description": "Plan editor: sets used to seed a card when the user adds an exercise from the picker (T167). Implemented by lastSessionSetSeed on Android; iPhone must produce identical results.",
  "scope": "Only the picker 'add exercise' path. Voice, templates, smart coach and repeat-last keep their explicit values. Without a seed (expected null) the card keeps today's default: one set, reps 10, last known weight or blank.",
  "rules": [
    "1. Only history rows of the requested exerciseId are considered. No rows -> null.",
    "2. Last completed session = the session with the greatest date; if several sessions share that date, the one with the greatest sessionId. Older sessions are never used.",
    "3. If the exercise appears in several blocks of that session, take ONLY the FIRST block (lowest blockOrderIndex). Blocks are NOT concatenated.",
    "4. Within that block, sets go in ascending setOrderIndex order (input row order is irrelevant).",
    "5. Sets with reps <= 0 are skipped. Weight 0 (bodyweight) is a valid weight and is kept.",
    "6. Take at most 10 sets (after skipping), and never more than the app's max sets per exercise (100, so 10 is the binding cap).",
    "7. Each seed set is {weight, reps} exactly as logged. If no set is left after the steps above the result is null (do not look at older sessions).",
    "8. Applying the seed (not covered by cases): the card's sets are replaced only while the card is still the untouched default (one set, blank weight, reps blank or 10); user edits are never overwritten."
  ],
  "inputFields": {
    "exerciseId": "exercise being added",
    "history": "rows of one logged set each: exerciseId, sessionId, date (any comparable number, e.g. epoch ms), blockOrderIndex (position of the exercise block in the workout), setOrderIndex (position in the block), weight (kg), reps"
  },
  "outputField": "expected = ordered list of {weight, reps}, or null when there is nothing to copy",
  "cases": [
    {
      "id": "no-history",
      "name": "No history at all -> null (keep the default card)",
      "exerciseId": 1,
      "history": [],
      "expected": null
    },
