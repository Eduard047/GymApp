{
  "version": 1,
  "productVersion": "3.1.1",
  "clients": ["android", "ios", "pwa"],
  "visibleCalendarDate": {
    "includeLocalizedWeekday": true,
    "compactStyle": "abbreviatedWeekdayAndMediumDate",
    "expandedStyle": "wideWeekdayAndLongDate",
    "chartStyle": "narrowWeekdayAndDayWithinSelectedMonth",
    "datePickerWeekday": "visibleAdjacentToControl",
    "supportedLanguages": ["en", "uk", "ru"],
    "excludedSurfaces": [
      "todayAndYesterdayLabels",
      "monthOnlySelectors",
      "timeOnlyLabels",
      "durationsAndTimers",
      "statusTimestamps",
      "calendarCellsWithAnAlreadyVisibleWeekdayHeader"
    ]
  },
  "todayHero": {
    "metricOrder": ["totalWorkouts", "weekStreak", "totalVolume"],
    "labels": {
      "totalWorkouts": {
        "en": "Total workouts",
        "uk": "Усього тренувань",
        "ru": "Всего тренировок"
      },
      "weekStreak": {
        "en": "Week streak",
        "uk": "Серія тижнів",
        "ru": "Серия недель"
      },
      "totalVolume": {
        "en": "Total volume",
        "uk": "Загальний обсяг",
        "ru": "Общий объём"
      }
    },
    "source": {
      "completedCanonicalHistoryOnly": true,
      "activeDraftCounted": false,
      "selectedMonthIndependent": true
    },
    "totalVolume": {
      "acceptFiniteNonNegativeValuesOnly": true,
      "maximumDisplayValue": 1000000000000000,
      "largeNumberStyle": "localizedCompactOneFractionDigit"
    },
    "layout": {
      "columns": 3,
      "preserveWeeklyRhythm": true,
      "preserveStartAndEditActions": true,
      "maximumValueLines": 1,
      "maximumLabelLines": 2
    }
  },
  "todayState": {
    "precedence": ["activeWorkout", "completedToday", "restOrRecovery", "recommendedPlan"],
    "completedTodaySource": "completedCanonicalHistoryInCurrentLocalCalendarDay",
    "completedTodaySuppresses": ["recoveryCard", "trainAnyway", "recommendedPlanActions"],
    "completedTodayActionsInOrder": ["createAnotherWorkout"],
    "retainedDraftActionOverride": {
      "actionsInOrder": ["continuePlan", "cancelPlan"],
      "createAnotherWorkoutSuppressed": true,
      "opensSameAccountRetainedDraft": true,
      "cancelPlanVisibleWithoutOverflow": true,
      "cancelPlanRequiresConfirmation": true,
      "cancelPlanRemoves": ["sameAccountRetainedDraft", "selectedLiveRecipient"],
      "cancelPlanPreserves": ["completedWorkoutHistory", "activeWorkout"]
    },
    "completedTodayCopy": {
      "title": {
        "en": "Workout complete",
        "uk": "Тренування завершено",
        "ru": "Тренировка завершена"
      },
      "body": {
        "en": "Today's work is saved in your history.",
        "uk": "Сьогоднішнє тренування збережено в історії.",
        "ru": "Сегодняшняя тренировка сохранена в истории."
      }
    }
  },
  "trainingHistory": {
    "periodsInOrder": ["week", "month"],
    "defaultPeriod": "week",
    "singleSurface": true,
    "oneWorkoutListFilteredToSelectedPeriod": true,
    "metricsInOrder": ["completedWorkouts", "trainingMinutes", "totalVolume"],
    "metricValueStyle": "localizedWholeNumberWithoutRepeatedUnitSuffix",
    "labels": {
      "completedWorkouts": {
        "en": "Workouts",
        "uk": "Тренування",
        "ru": "Тренировки"
      },
      "trainingMinutes": {
        "en": "Minutes",
        "uk": "Хвилини",
        "ru": "Минуты"
      },
      "totalVolume": {
        "en": "Volume",
        "uk": "Обсяг",
        "ru": "Объём"
      }
    },
    "week": {
      "calendar": "localMondayStartSevenDayWeek",
      "dayMarkers": 7,
      "trainedDayMarker": "filledCircleWhenAtLeastOneCompletedSessionExists",
      "headerMetric": "completedTrainingDaysVsProfileTarget"
    },
    "month": {
      "calendar": "localMondayFirstMonthGrid",
      "trainedDayMarker": "highlightedDayWhenAtLeastOneCompletedSessionExists",
      "headerMetric": "completedTrainingDays"
    },
    "completedHistoryOnly": true,
    "activeDraftCounted": false,
    "trainingMinutes": {
      "measuredDurationPreferredWhenCanonicalHistoryProvidesIt": true,
      "fallbackEstimatePerSession": "min(90,max(10,exerciseCount*3+setCount*2))",
      "minimumPerSession": 10,
      "maximumPerSession": 90,
      "rounding": "wholeMinutes"
    },
    "totalVolume": {
      "acceptFiniteNonNegativeValuesOnly": true
    }
  },
  "pwaReleaseCoupling": {
    "appBundle": "app.v107.js",
    "styleBundle": "styles.v83.css",
    "russianBundle": "russian-text.v87.js",
    "liveWorkoutBundle": "live-workout.v3.js",
    "serviceWorkerCache": "gym-pwa-v149"
  }
}
