{
  "version": 1,
  "description": "Phone to watch Garmin sync message. Each case runs through the real Android and iOS builders and must produce expected plus that platform's extras, key for key. input.language is the app UI language and is ignored: the watch always gets language en and Latin exercise names. The runner first converts input plan and exerciseCandidates names to Latin with the shared conversion in garmin-latin-names-v1.json (no stored table), then calls the builder; rejectCases feed non-ASCII names straight to the builder, which must refuse them.",
  "watchLanguage": "en",
  "watchMaximumKeys": 15,
  "binding": {
    "account": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "device": "123456789",
    "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  },
  "syncId": "sync-11111111-2222-3333-4444-555555555555",
  "cases": [
    {
      "id": "plan-cyrillic-two-decimal-weight-with-catalog",
      "input": {
        "language": "ru",
        "syncRevision": 1800000000123,
        "plan": [
          { "exerciseName": "Жим лёжа", "weight": 21.25, "reps": 8 },
          { "exerciseName": "Жим лёжа", "weight": 22.5, "reps": 6 },
          { "exerciseName": "Присед", "weight": 100, "reps": 5 }
        ],
        "exerciseCandidates": ["Присед", "Тяга штанги", "Жим лёжа", "Румынская тяга"],
        "resetWorkout": false,
        "repairPairing": false,
        "bindingOnly": false
      },
      "expected": {
        "type": "sync",
        "bindingVersion": 2,
        "syncId": "sync-11111111-2222-3333-4444-555555555555",
        "requestId": "sync-11111111-2222-3333-4444-555555555555",
        "accountBinding": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "deviceBinding": "123456789",
        "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "syncRevision": 1800000000123,
        "language": "en",
        "resetWorkout": false,
        "planNames": ["Zhym lyozha", "Zhym lyozha", "Prysed"],
        "planWeights": [21.25, 22.5, 100],
        "planReps": [8, 6, 5],
        "exercises": ["Zhym lyozha", "Prysed", "Tyaga shtangy", "Rumynskaya tyaga"]
      },
      "platformExtras": { "android": {}, "ios": { "bindingSource": "phone" } }
    },
    {
      "id": "plan-zero-weight-no-extra-catalog",
      "input": {
        "language": "uk",
        "syncRevision": 1800000000124,
        "plan": [
          { "exerciseName": "Станова тяга", "weight": 0, "reps": 12 },
          { "exerciseName": "Станова тяга", "weight": 62.5, "reps": 1 }
        ],
        "exerciseCandidates": [],
        "resetWorkout": false,
        "repairPairing": false,
        "bindingOnly": false
      },
      "expected": {
        "type": "sync",
        "bindingVersion": 2,
        "syncId": "sync-11111111-2222-3333-4444-555555555555",
        "requestId": "sync-11111111-2222-3333-4444-555555555555",
        "accountBinding": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "deviceBinding": "123456789",
        "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "syncRevision": 1800000000124,
        "language": "en",
        "resetWorkout": false,
        "planNames": ["Deadlift", "Deadlift"],
        "planWeights": [0, 62.5],
        "planReps": [12, 1],
        "exercises": ["Deadlift"]
      },
      "platformExtras": { "android": {}, "ios": { "bindingSource": "phone" } }
    },
    {
      "id": "binding-only-lite-empty-plan",
      "input": {
        "language": "en",
        "syncRevision": 1800000000125,
        "plan": [],
        "exerciseCandidates": [],
        "resetWorkout": false,
        "repairPairing": false,
