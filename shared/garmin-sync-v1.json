        "accountBinding": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "deviceBinding": "123456789",
        "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "syncRevision": 1800000000125,
        "language": "en",
        "resetWorkout": false,
        "planNames": [],
        "planWeights": [],
        "planReps": []
      },
      "platformExtras": { "android": {}, "ios": { "bindingSource": "phone" } }
    },
    {
      "id": "binding-only-reset-workout",
      "input": {
        "language": "uk",
        "syncRevision": 1800000000126,
        "plan": [],
        "exerciseCandidates": [],
        "resetWorkout": true,
        "repairPairing": false,
        "bindingOnly": true
      },
      "expected": {
        "type": "sync",
        "bindingVersion": 2,
        "syncId": "sync-11111111-2222-3333-4444-555555555555",
        "requestId": "sync-11111111-2222-3333-4444-555555555555",
        "accountBinding": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "deviceBinding": "123456789",
        "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "syncRevision": 1800000000126,
        "language": "en",
        "resetWorkout": true,
        "planNames": [],
        "planWeights": [],
        "planReps": []
      },
      "platformExtras": { "android": {}, "ios": { "bindingSource": "phone" } }
    },
    {
      "id": "binding-only-repair-pairing",
      "input": {
        "language": "ru",
        "syncRevision": 1800000000127,
        "plan": [],
        "exerciseCandidates": [],
        "resetWorkout": false,
        "repairPairing": true,
        "bindingOnly": true
      },
      "expected": {
        "type": "sync",
        "bindingVersion": 2,
        "syncId": "sync-11111111-2222-3333-4444-555555555555",
        "requestId": "sync-11111111-2222-3333-4444-555555555555",
        "accountBinding": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "deviceBinding": "123456789",
        "pairingGeneration": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "syncRevision": 1800000000127,
        "language": "en",
        "repairPairing": true,
        "planNames": [],
        "planWeights": [],
        "planReps": []
      },
      "platformExtras": {
        "android": { "resetWorkout": false },
        "ios": { "bindingSource": "phone" }
      }
    }
  ],
  "rejectCases": [
    {
      "id": "non-ascii-plan-name-is-never-sent",
      "input": {
        "plan": [{ "exerciseName": "Присед", "weight": 100, "reps": 5 }],
        "exerciseCandidates": []
      }
    },
    {
      "id": "non-ascii-catalog-name-is-never-sent",
      "input": {
        "plan": [{ "exerciseName": "Squat", "weight": 100, "reps": 5 }],
        "exerciseCandidates": ["Тяга штанги"]
      }
    }
  ],
  "knownPlatformDifferences": [
    "iOS adds bindingSource=phone to every sync; Android omits it (the watch derives the source from the transport).",
    "With repairPairing, Android also sends resetWorkout=false; iOS omits resetWorkout. The watch accepts both."
  ]
}
