            "bestWeight": 100,
            "bestEstimatedOneRepMax": 116.666666667
          }
        },
        "records": [
          {
            "exercise": "bench",
            "sets": [
              false,
              true,
              false
            ]
          }
        ]
      }
    },
    {
      "id": "running-best-within-workout",
      "description": "Each set compares with the better of history and earlier sets of this workout.",
      "history": [
