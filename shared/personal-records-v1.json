          ]
        }
      ],
      "expected": {
        "baselines": {
          "bench": {
            "bestWeight": 100,
            "bestEstimatedOneRepMax": 116.666666667
          }
        },
        "records": [
          {
            "exercise": "bench",
            "sets": [
              true,
              false
            ]
          }
        ]
      }
    },
