    {
      "id": "decimal-weights",
      "description": "Plate-sized decimals: 2.5 and 1.25 kg steps.",
      "history": [
        {
          "exercise": "curl",
          "weight": 1.25,
          "reps": 8
        },
        {
          "exercise": "curl",
          "weight": 2.5,
          "reps": 5
        }
      ],
      "workout": [
        {
          "exercise": "curl",
          "sets": [
            {
              "weight": 2.5,
              "reps": 6
            },
            {
              "weight": 3.75,
              "reps": 1
            },
            {
              "weight": 1.25,
              "reps": 20
            }
          ]
        }
      ],
      "expected": {
        "baselines": {
          "curl": {
            "bestWeight": 2.5,
            "bestEstimatedOneRepMax": 2.916666667
