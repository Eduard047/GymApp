        {
          "exercise": "bench",
          "when": "later",
          "weight": 200,
          "reps": 5
        },
        {
          "exercise": "bench",
          "when": "self",
          "weight": 90,
          "reps": 5
        }
      ],
      "workout": [
        {
          "exercise": "bench",
          "sets": [
            {
              "weight": 90,
              "reps": 5
            }
          ]
        }
      ],
      "expected": {
        "records": [
          {
            "exercise": "bench",
            "sets": [
              false
            ]
          }
        ]
      }
    },
    {
      "id": "stored-same-date-tie-break",
      "description": "Same date: only the workout with the lower id counts as earlier.",
      "history": [
        {
          "exercise": "bench",
          "when": "same-date-lower-id",
          "weight": 100,
          "reps": 5
        },
        {
          "exercise": "bench",
          "when": "same-date-higher-id",
          "weight": 300,
          "reps": 5
        }
      ],
      "workout": [
        {
          "exercise": "bench",
          "sets": [
            {
              "weight": 110,
              "reps": 3
            },
            {
              "weight": 100,
              "reps": 5
            },
            {
              "weight": 95,
              "reps": 5
            }
          ]
        }
      ],
      "expected": {
        "records": [
          {
            "exercise": "bench",
            "sets": [
              true,
              false,
              false
            ]
          }
        ]
      }
    },
    {
      "id": "stored-running-best-weight-and-estimate",
      "description": "Several sets beat the earlier best: each one that beats the running best is a record, by weight or by estimated one-rep max alone.",
      "history": [
