<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Held only for the length of one rest countdown (with a timeout), so the "rest finished"
         vibration fires on time while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Heart rate and calories through Health Services' ExerciseClient. Requested at workout
         start; the workout itself works without them. BODY_SENSORS covers Wear OS 5 and older,
         READ_HEART_RATE is its replacement on Wear OS 6 (API 36). -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <application
        android:name=".WearGymApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/wear_data_extraction_rules"
        android:fullBackupContent="@xml/wear_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymWear"
        tools:targetApi="s">
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GymWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".health.WearExerciseService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".sync.WatchSyncListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/gym/sync/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The phone app (capability in the app module res/values/wear.xml) became reachable: send the workout that waits. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />

                <data
                    android:host="*"
                    android:path="/gymapp_phone_sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
