<?xml version="1.0" encoding="utf-8"?>
<!-- Wearable Data Layer capability of the watch app. The phone app listens for it
     (CAPABILITY_CHANGED, wear://*/gymapp_watch_sync) to resend the state and the plan that wait
     for the watch. tools:keep stops resource shrinking from removing an unreferenced array. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">
    <string-array name="android_wear_capabilities" translatable="false">
        <item>gymapp_watch_sync</item>
    </string-array>
</resources>
