<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- In-process Compose test host. It has no intent filter and is never externally reachable. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

        <!-- Debug builds cannot use the production Play-signing App Link. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:path="/callback"
                    android:scheme="${authCallbackScheme}" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".garmin.GarminDebugReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.setforge.gymapp.DEBUG_GARMIN_SYNC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
