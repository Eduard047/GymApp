<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth sessions and PKCE verifiers are device-bound and must never enter backups. -->
        <exclude domain="sharedpref" path="gym_cloud_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gym_cloud_auth.xml" />
    </device-transfer>
</data-extraction-rules>
