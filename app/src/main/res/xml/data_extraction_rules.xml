<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Workout databases contain private account-scoped data and are restored in-app instead. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <!-- Auth sessions, PKCE verifiers, push bindings, and Garmin credentials are device-bound. -->
        <exclude domain="sharedpref" path="gym_cloud_auth.xml" />
        <exclude domain="sharedpref" path="gym_cloud_auth.xml.bak" />
        <exclude domain="sharedpref" path="gym_cloud_auth_secure.xml" />
        <exclude domain="sharedpref" path="gym_cloud_auth_secure.xml.bak" />
        <exclude domain="sharedpref" path="gym_cloud_account_deletion_journal.xml" />
        <exclude domain="sharedpref" path="gym_cloud_account_deletion_journal.xml.bak" />
        <exclude domain="sharedpref" path="gym_local_database_bindings.xml" />
        <exclude domain="sharedpref" path="gym_local_database_bindings.xml.bak" />
        <exclude domain="sharedpref" path="gym_local_profile_registry_v1.xml" />
        <exclude domain="sharedpref" path="gym_local_profile_registry_v1.xml.bak" />
        <exclude domain="sharedpref" path="gym_local_profile_deletion_journal_v1.xml" />
        <exclude domain="sharedpref" path="gym_local_profile_deletion_journal_v1.xml.bak" />
        <exclude domain="sharedpref" path="garmin_sync.xml" />
        <exclude domain="sharedpref" path="garmin_sync.xml.bak" />
        <exclude domain="sharedpref" path="phone_wear_sync.xml" />
        <exclude domain="sharedpref" path="phone_wear_sync.xml.bak" />
        <exclude domain="sharedpref" path="gym_training_profile.xml" />
        <exclude domain="sharedpref" path="gym_training_profile.xml.bak" />
        <exclude domain="sharedpref" path="gym_training_profiles.xml" />
        <exclude domain="sharedpref" path="gym_training_profiles.xml.bak" />
        <exclude domain="sharedpref" path="gym_training_guidance_v1.xml" />
        <exclude domain="sharedpref" path="gym_training_guidance_v1.xml.bak" />
        <exclude domain="sharedpref" path="gym_cloud_sync_baselines.xml" />
        <exclude domain="sharedpref" path="gym_cloud_sync_baselines.xml.bak" />
        <exclude domain="sharedpref" path="gym_exercise_rest_timers.xml" />
        <exclude domain="sharedpref" path="gym_exercise_rest_timers.xml.bak" />
        <exclude domain="sharedpref" path="gym_active_workout_timer.xml" />
        <exclude domain="sharedpref" path="gym_active_workout_timer.xml.bak" />
        <exclude domain="sharedpref" path="gym_live_workout_sidecar.xml" />
        <exclude domain="sharedpref" path="gym_live_workout_sidecar.xml.bak" />
        <exclude domain="sharedpref" path="gym_social_workout_invite_requests.xml" />
        <exclude domain="sharedpref" path="gym_social_workout_invite_requests.xml.bak" />
        <exclude domain="sharedpref" path="gym_push_installation.xml" />
        <exclude domain="sharedpref" path="gym_push_installation.xml.bak" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml.bak" />
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="gym_cloud_auth.xml" />
        <exclude domain="sharedpref" path="gym_cloud_auth.xml.bak" />
        <exclude domain="sharedpref" path="gym_cloud_auth_secure.xml" />
        <exclude domain="sharedpref" path="gym_cloud_auth_secure.xml.bak" />
        <exclude domain="sharedpref" path="gym_cloud_account_deletion_journal.xml" />
