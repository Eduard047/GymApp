<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Workout databases contain private account-scoped data and are restored in-app instead. -->
    <exclude domain="database" path="." />
    <!-- User-selected exercise images stay device-local and account-bound. -->
    <exclude domain="file" path="exercise-media/" />
    <!-- Auth sessions, PKCE verifiers, and Garmin credentials are device-bound. -->
    <exclude domain="sharedpref" path="gym_cloud_auth.xml" />
    <exclude domain="sharedpref" path="gym_cloud_auth.xml.bak" />
    <exclude domain="sharedpref" path="gym_cloud_account_deletion_journal.xml" />
    <exclude domain="sharedpref" path="gym_cloud_account_deletion_journal.xml.bak" />
    <exclude domain="sharedpref" path="gym_local_database_bindings.xml" />
    <exclude domain="sharedpref" path="gym_local_database_bindings.xml.bak" />
    <exclude domain="sharedpref" path="garmin_sync.xml" />
    <exclude domain="sharedpref" path="garmin_sync.xml.bak" />
    <exclude domain="sharedpref" path="phone_wear_sync.xml" />
    <exclude domain="sharedpref" path="phone_wear_sync.xml.bak" />
    <exclude domain="sharedpref" path="gym_training_profile.xml" />
    <exclude domain="sharedpref" path="gym_training_profile.xml.bak" />
    <exclude domain="sharedpref" path="gym_training_profiles.xml" />
    <exclude domain="sharedpref" path="gym_training_profiles.xml.bak" />
    <exclude domain="sharedpref" path="gym_cloud_sync_baselines.xml" />
    <exclude domain="sharedpref" path="gym_cloud_sync_baselines.xml.bak" />
    <exclude domain="sharedpref" path="gym_exercise_rest_timers.xml" />
    <exclude domain="sharedpref" path="gym_exercise_rest_timers.xml.bak" />
    <exclude domain="sharedpref" path="gym_active_workout_timer.xml" />
    <exclude domain="sharedpref" path="gym_active_workout_timer.xml.bak" />
</full-backup-content>
