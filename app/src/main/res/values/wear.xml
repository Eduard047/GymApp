<?xml version="1.0" encoding="utf-8"?>
<!-- Wearable Data Layer capability of the phone app. The watch app listens for it
     (CAPABILITY_CHANGED, wear://*/gymapp_phone_sync) to send the workout that waits for the phone.
     tools:keep stops resource shrinking from removing an array no code references. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">
    <string-array name="android_wear_capabilities" translatable="false">
        <item>gymapp_phone_sync</item>
    </string-array>
</resources>
