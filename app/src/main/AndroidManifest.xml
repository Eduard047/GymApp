<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice workout dictation: on-device recognition only, requested at first use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Health Connect, read-only: gym workouts, their heart rate and calories from any watch brand.
         The library declares minSdk 26; every call is guarded by an API 26 + availability check
         (health/HealthConnectImporter.kt), so the app keeps minSdk 24. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Watches screen: offers "Install Garmin Connect" only when the app is missing. -->
        <package android:name="com.garmin.android.apps.connectmobile" />
    </queries>

    <application
        android:name=".GymApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymApp">
        <!-- Push registration is opt-in and initialized explicitly after account/permission checks. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_messaging_notification_delegation_enabled"
            android:value="false" />

        <!-- Conversion measurement is opt-in: everything is off and denied until the user allows it
             in the consent prompt or Settings (see analytics/ConversionAnalytics.kt). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- Launcher shortcut trampoline. The launcher starts shortcut targets with NEW_TASK|CLEAR_TASK,
             which would destroy a live MainActivity (and the unsaved workout plan). It has its own
             task affinity so that CLEAR_TASK only ever clears this transient task, and it forwards
             to MainActivity with SINGLE_TOP|CLEAR_TOP so a running instance gets onNewIntent. -->
        <activity
            android:name=".StartWorkoutShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GymApp.Trampoline" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GymApp.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gymapptracker.com"
                    android:path="/workout/"
                    android:scheme="https" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gymapptracker.com"
                    android:path="/auth/android-callback.html"
                    android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="workout"
                    android:path="/"
                    android:scheme="${authCallbackScheme}" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission rationale: static text, no input is read from the intent. -->
        <activity
            android:name=".health.HealthPermissionRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GymApp">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+: Health Connect opens this from its "privacy policy" entry. -->
        <activity-alias
            android:name=".health.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthPermissionRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <receiver
            android:name=".service.RestTimerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.ActiveWorkoutNotificationReceiver"
            android:exported="false" />

        <service
            android:name=".push.GymFirebaseMessagingService"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Google Play Services must be able to bind this listener. Every message is still
             authenticated to the single pinned Data Layer node before parsing or mutation. -->
        <service
            android:name=".wearsync.PhoneWearSyncListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />

                <data
                    android:host="*"
                    android:pathPrefix="/gym/sync/"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The watch app (capability in the wear module res/values/wear.xml) became reachable: resend what waits for it. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />

                <data
                    android:host="*"
                    android:path="/gymapp_watch_sync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
